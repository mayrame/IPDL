<h2>Inscription à la newsletter</h2>

<% if (locals.errors && locals.errors.length > 0) { %>
    <div class="alert alert-danger">
        <ul class="mb-0">
            <% locals.errors.forEach(error => { %>
                <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form action="/subscribers/create" method="POST">
    <div class="form-group">
        <label for="name">Nom complet</label>
        <input type="text" class="form-control <%= locals.errors && locals.errors.some(e => e.includes('nom')) ? 'is-invalid' : '' %>" 
               id="name" name="name" 
               value="<%= locals.formData ? locals.formData.name : '' %>" 
               required>
    </div>
    
    <div class="form-group">
        <label for="email">Email</label>
        <input type="email" class="form-control <%= locals.errors && locals.errors.some(e => e.includes('email')) ? 'is-invalid' : '' %>" 
               id="email" name="email"
               value="<%= locals.formData ? locals.formData.email : '' %>" 
               required>
    </div>
    
    <div class="form-group">
        <label for="zipCode">Code Postal</label>
        <input type="text" class="form-control <%= locals.errors && locals.errors.some(e => e.includes('postal')) ? 'is-invalid' : '' %>" 
               id="zipCode" name="zipCode"
               value="<%= locals.formData ? locals.formData.zipCode : '' %>"
               pattern="\d{5}" required>
        <small class="form-text text-muted">5 chiffres requis</small>
    </div>
    
    <button type="submit" class="btn btn-primary">S'abonner</button>
</form>